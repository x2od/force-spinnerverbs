{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["github>x2od/.github:renovate.jsonc"],
	"autoApprove": true,
	"automerge": true,
	"addLabels": ["renovate", "auto-merged"],
	"dependencyDashboardAutoclose": true,
	"configWarningReuseIssue": false,
	"packageRules": [
		{
			"description": "Auto-approve and auto-merge all updates. Later rules override the preset's rules.",
			"matchPackageNames": ["*"],
			"automerge": true,
			"autoApprove": true,
			"dependencyDashboardApproval": false,
			"addLabels": ["renovate", "auto-merged"]
		}
	]
}
